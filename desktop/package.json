{
  "name": "abofarwla-tv",
  "productName": "أبو فراولة TV",
  "version": "1.0.0",
  "description": "أبو فراولة TV",
  "main": "main.js",
  "author": "bmeshary-crypto",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable nsis --publish never"
  },
  "build": {
    "appId": "io.github.bmeshary-crypto.abofarwla",
    "files": [
      "main.js",
      "icon.png"
    ],
    "win": {
      "icon": "icon.png",
      "signAndEditExecutable": false
    },
    "nsis": {
      "oneClick": true,
      "artifactName": "AbuFarawla-TV-Setup.exe"
    },
    "portable": {
      "artifactName": "AbuFarawla-TV-portable.exe"
    }
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  }
}
